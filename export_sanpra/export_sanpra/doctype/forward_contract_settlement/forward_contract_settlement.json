      "fieldtype": "Link",
      "options": "Bank",
      "reqd": 1,
      "label": "Bank"
    },
    {
      "fieldname": "settlement_date",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "Settlement Date"
    },
    {
      "fieldname": "currency",
